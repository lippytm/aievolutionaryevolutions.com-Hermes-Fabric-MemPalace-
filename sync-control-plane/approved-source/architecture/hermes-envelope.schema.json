{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aievolutionaryevolutions.com/schemas/hermes-envelope-v0.1.json",
  "title": "Hermes Federation Message Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "message_id", "conversation_id", "thread_id",
    "mission_id", "sent_at", "sender", "recipients", "act",
    "scope", "classification", "payload", "payload_hash",
    "provenance_refs", "permissions", "response_contract", "audit"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "message_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "in_reply_to": {"type": ["string", "null"]},
    "supersedes": {"type": ["string", "null"]},
    "sent_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brain_id", "fleet_id", "provider", "model"],
      "properties": {
        "brain_id": {"type": "string", "pattern": "^[BP][0-9]{2}$"},
        "fleet_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "adapter_version": {"type": ["string", "null"]}
      }
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "act": {
      "enum": ["ASK", "PROPOSE", "DELEGATE", "TEACH", "CHALLENGE", "VERIFY", "DISSENT", "ACK", "ESCALATE", "DECIDE", "CORRECT", "STOP"]
    },
    "scope": {"enum": ["platform", "tenant", "personal_vault", "sanitized_bridge"]},
    "classification": {"enum": ["public", "internal", "confidential", "restricted", "prohibited"]},
    "content_label": {"enum": ["fact", "claim", "hypothesis", "simulation", "education", "fiction", "advertisement", "human_decision"]},
    "payload": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string"},
        "artifact_refs": {"type": "array", "items": {"type": "string"}},
        "database_refs": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "payload_hash": {"type": "string", "minLength": 1},
    "provenance_refs": {"type": "array", "items": {"type": "string"}},
    "permissions": {
      "type": "object",
      "required": ["tools", "data_scopes", "human_approval_required"],
      "properties": {
        "tools": {"type": "array", "items": {"type": "string"}},
        "data_scopes": {"type": "array", "items": {"type": "string"}},
        "human_approval_required": {"type": "boolean"}
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_usd": {"type": "number", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_tool_calls": {"type": "integer", "minimum": 0}
      }
    },
    "response_contract": {
      "type": "object",
      "required": ["ack_required", "expected_act"],
      "properties": {
        "ack_required": {"type": "boolean"},
        "expected_act": {"type": ["string", "null"]},
        "deadline": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "signature": {"type": ["string", "null"]},
    "audit": {
      "type": "object",
      "required": ["riskgate_status", "mempalace_receipt_required"],
      "properties": {
        "riskgate_status": {"enum": ["pending", "green", "yellow", "red"]},
        "mempalace_receipt_required": {"type": "boolean"},
        "qa_refs": {"type": "array", "items": {"type": "string"}},
        "cost_usd": {"type": "number", "minimum": 0}
      }
    }
  }
}
